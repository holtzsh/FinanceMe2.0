        <name>Go to Account</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function() {
    // Get the sc_req_item from current.sysapproval
    var ritmGR = new GlideRecord('sc_req_item');
    if (!ritmGR.get(current.sysapproval)) {
        gs.addErrorMessage('Could not find the associated Requested Item.');
        return;
    }

    // Read variables: account (sys_id) and amount (string)
    var account = ritmGR.variables.account.toString();
    var amount = ritmGR.variables.amount.toString();

    if (!account || !amount) {
        gs.addErrorMessage('Could not retrieve account or amount from the request variables.');
        return;
    }

    // Determine type from catalog item display name
    // "Deposit Request" → deposit, otherwise → withdrawal
    var catItemName = ritmGR.cat_item.getDisplayValue();
    var type = (catItemName.indexOf('Deposit') >= 0) ? 'deposit' : 'withdrawal';

    // Redirect to the accounts form with approval context parameters
    action.setRedirectURL(
        'x_274351_finance_0_accounts.do?sys_id=' + account +
        '&sysparm_action_type=' + type +
        '&sysparm_amount=' + amount
    );
})();
]]></script>
