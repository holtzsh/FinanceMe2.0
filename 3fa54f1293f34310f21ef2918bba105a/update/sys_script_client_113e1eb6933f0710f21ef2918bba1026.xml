        <name>Validate ACH Form Submission</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var account = g_form.getValue('account');
    var amount = parseFloat(g_form.getValue('amount'));

    if (!account) {
        g_form.showFieldMsg('account', 'Source account is required.', 'error');
        return false;
    }

    if (isNaN(amount) || amount <= 0) {
        g_form.showFieldMsg('amount', 'Please enter a valid amount greater than 0.', 'error');
        return false;
    }

    return true;
}]]></script>
