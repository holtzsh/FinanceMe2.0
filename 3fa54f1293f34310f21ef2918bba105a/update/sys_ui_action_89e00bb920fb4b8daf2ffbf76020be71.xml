        <order>100</order>
        <script><![CDATA[function depositFunds() {
    var amount = prompt('Enter deposit amount ($):');
    if (!amount || isNaN(parseFloat(amount)) || parseFloat(amount) <= 0) {
        alert('Please enter a valid amount greater than 0.');
        return;
    }
    var ga = new GlideAjax('x_274351_finance_0.AchTransferHandler');
    ga.addParam('sysparm_name', 'deposit');
    ga.addParam('sysparm_account_sys_id', g_form.getUniqueValue());
    ga.addParam('sysparm_amount', amount);
    ga.getXMLAnswer(function(answer) {
        var result = JSON.parse(answer);
        if (result.success) {
            alert('Deposit of $' + parseFloat(amount).toFixed(2) + ' successful.');
            window.location.reload();
        } else {
            alert('Deposit failed: ' + result.message);
        }
    });
}]]></script>
