    <script><![CDATA[function deactivateAccount() {
    if (!confirm('Are you sure you want to deactivate this account? This action cannot be undone from this form.')) {
        return;
    }
    var ga = new GlideAjax('x_274351_finance_0.AchTransferHandler');
    ga.addParam('sysparm_name', 'deactivateAccount');
    ga.addParam('sysparm_account_sys_id', g_form.getUniqueValue());
    ga.getXMLAnswer(function(answer) {
        var result = JSON.parse(answer);
        if (result.success) {
            alert('Account has been deactivated.');
            window.location.reload();
        } else {
            alert('Deactivation failed: ' + result.message);
        }
    });
}]]></script>
